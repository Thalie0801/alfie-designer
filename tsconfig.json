{
  "compilerOptions": {
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": true,
    "types": [
      "node"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*",
        "lib/*",
        "types/*"
      ]
    }
  },
  "include": [
    "api",
    "src",
    "lib",
    "types",
    "scripts",
    "prisma",
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
