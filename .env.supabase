# Supabase environment configuration for local migrations
# Fill these values before running migrate_to_supabase.js
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_DB_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Frontend variables (exposées côté Vite)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Lovable (source) configuration
LOVABLE_DATABASE_URL="postgresql://user:password@lovable-host:5432/postgres"
LOVABLE_SERVICE_KEY="lovable-service-role-key"
LOVABLE_API_URL="https://api.lovable.dev"
LOVABLE_API_KEY="your-lovable-api-key"

# Optional overrides
# LOVABLE_AUTH_SETTINGS_FILE="config/lovable-auth-providers.json"
# SUPABASE_SITE_URL="https://your-vercel-app.vercel.app"
# SUPABASE_REDIRECT_URLS="https://your-vercel-app.vercel.app/auth/callback"
