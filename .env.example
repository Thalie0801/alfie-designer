# Environment configuration for Alfie Designer

# Prisma / Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alfie_designer"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/alfie_designer"

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
STORAGE_BUCKET=assets
VITE_SHOW_DEBUG=false

# Stripe billing
STRIPE_SECRET_KEY="sk_test_your_key"
STRIPE_WEBHOOK_SECRET="whsec_your_secret"

# Webhooks vidéo
VIDEO_WEBHOOK_SECRET="change-me-32+-chars"
ALLOWED_ASSET_URL_PREFIXES="https://your-project.supabase.co/storage/v1/object/public/"

# Application
BASE_URL=http://localhost:3000
